# Copier ce fichier en .env sur chaque machine, puis remplacer TOUTES les valeurs.
#   cp .env.example .env && chmod 600 .env
# Le fichier .env n'est jamais commité (voir .gitignore).

# --- Django -------------------------------------------------------------------
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=0
# Adresse IP ou nom avec lequel tu accèdes au serveur (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=192.168.1.50
DJANGO_CSRF_TRUSTED_ORIGINS=https://192.168.1.50
# Chemin de l'administration (évite le /admin/ trop connu)
DJANGO_ADMIN_URL_PATH=gestion-a-personnaliser
# Mettre 31536000 une fois HTTPS validé avec un certificat définitif
DJANGO_HSTS_SECONDS=0
# Inscriptions publiques : fermées par défaut (comptes créés par un administrateur) ; 1 pour les ouvrir
SIGNUP_ENABLED=0
# Double authentification obligatoire pour administrateurs, gestionnaires et rédacteurs (1 recommandé)
MFA_REQUIRED_FOR_PRIVILEGED=1
# Déconnexion des comptes à droits élevés après N minutes d'inactivité
PRIVILEGED_IDLE_MINUTES=30
GUIDE_MAX_UPLOAD_MB=50

# --- IA locale : 1 avec une carte graphique NVIDIA (profil Compose « ia ») ; 0 sinon (fonctions d'IA masquées)
AI_ENABLED=1
# Pré-relecteur IA des QCM et cours générés (notes pour le relecteur, questions ratées régénérées) ; 0 pour le couper
PREREVIEW_ENABLED=1

# --- E-mails (invitations, mot de passe oublié) ; vide : liens à transmettre à la main ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Instance (affichées dans l'en-tête, le pied de page et les pages légales) -------
INSTANCE_NAME=CyberLearning
ORGANISATION_NAME=
ORGANISATION_ADDRESS=
ORGANISATION_ID=
CONTACT_EMAIL=
DPO_EMAIL=
HOSTING_PROVIDER=
# Programmes d'examen des certifications tierces (ISC2, ISACA, CompTIA…) : 0 pour les masquer
THIRD_PARTY_EXAM_OUTLINES=1

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=cyberlearning
POSTGRES_USER=cyberlearning
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=a-remplacer

# --- Ports publiés par nginx --------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443
